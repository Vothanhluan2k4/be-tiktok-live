# Backend Environment Variables (Render.com)

# Node environment (production or development)
NODE_ENV=production

# Server Port (Render automatically sets PORT)
PORT=5000

# Backend External Domain URL (Auto-detected on Render via RENDER_EXTERNAL_URL if omitted)
SERVER_URL=https://be-tiktok-live.onrender.com

# MongoDB Connection URI (Optional: Leave empty for In-Memory Mode)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tiktok_tts
